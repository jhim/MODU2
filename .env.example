# Choose "mock" for local development/e2e, or "production" with all server credentials below.
MODU2_MODE=mock
# Server-only secret values. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional local/mock-mode JWT verification; public anon key, not a secret.
SUPABASE_ANON_KEY=
# Public Supabase Auth client configuration, embedded in the browser build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Railway injects PORT at runtime.
PORT=3000
LOG_LEVEL=info
