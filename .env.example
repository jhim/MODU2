# Choose "mock" for local development/e2e, or "production" with all credentials below.
MODU2_MODE=mock
# Never expose this value to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# MODU2_MODE=production requires both Supabase values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local server port. Railway injects PORT at runtime.
PORT=3000
LOG_LEVEL=info
